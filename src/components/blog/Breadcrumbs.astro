---
import Icon from "@/components/ui/Icon.astro";
import type { Crumb } from "@/lib/schema";

interface Props {
  items: Crumb[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
    {items.map((item, index) => (
      <li class="flex min-w-0 items-center gap-1.5">
        {index > 0 && <Icon name="chevron-right" class="size-3.5 opacity-60" />}
        {item.href ? (
          <a href={item.href} class="transition-colors hover:text-ink">
            {item.label}
          </a>
        ) : (
          <span aria-current="page" class="truncate text-ink">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
