---
import PostCard from "@/components/blog/PostCard.astro";
import type { Post } from "@/lib/posts";

interface Props {
  posts: Post[];
  headingLevel?: 2 | 3;
}

const { posts, headingLevel = 2 } = Astro.props;
---

<div class="shell grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
  {posts.map((post) => (
    <PostCard post={post} headingLevel={headingLevel} />
  ))}
</div>
