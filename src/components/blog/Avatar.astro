---
import { Image } from "astro:assets";
import type { Author } from "@/config/authors";

interface Props {
  author: Author;
  /** Rendered size in CSS pixels. */
  size?: number;
  class?: string;
}

const { author, size = 28, class: className } = Astro.props;
---

<Image
  src={author.avatar}
  alt=""
  width={size}
  height={size}
  densities={[1, 2]}
  quality={80}
  class:list={["shrink-0 rounded-full bg-sunken object-cover", className]}
  style={`width:${size}px;height:${size}px`}
/>
