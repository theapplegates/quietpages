---
const lucide = import.meta.glob<string>("/src/icons/lucide/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const bootstrap = import.meta.glob<string>("/src/icons/bootstrap/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const fileName = (path: string) => path.replace(/^.*\/|\.svg$/g, "");
const clean = (svg: string) =>
  svg
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/<svg[^>]*>/, (tag) => tag.replace(/\s(width|height|class)="[^"]*"/g, ""));

const outline = Object.fromEntries(
  Object.entries(lucide).map(([path, svg]) => [
    fileName(path),
    clean(svg).replace('stroke-width="2"', 'stroke-width="1.75"'),
  ]),
);

/* Filled brand marks, addressed as `social-<file name>`, e.g. `social-github`. */
const brands = Object.fromEntries(
  Object.entries(bootstrap).map(([path, svg]) => [`social-${fileName(path)}`, clean(svg)]),
);

interface Props {
  /** A file name from `src/icons/lucide`, or `social-<name>` for `src/icons/bootstrap`. */
  name: string;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;
const svg = brands[name] ?? outline[name];
if (!svg) throw new Error(`Icon "${name}" not found in src/icons.`);
---

<span
  class:list={["icon shrink-0 place-items-center [&>svg]:size-full", className]}
  aria-hidden="true"
  set:html={svg}
/>

<style is:global>
  @layer base {
    .icon:not(.hidden) {
      display: inline-grid;
    }
  }
</style>
