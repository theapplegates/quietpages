---
import { Image } from "astro:assets";
import Icon from "@/components/ui/Icon.astro";
import { categories } from "@/config/taxonomy";
import { categoryUrl, plural, type Post } from "@/lib/posts";

interface Props {
  posts: Post[];
  title: string;
  lead?: string;
}

const { posts, title, lead } = Astro.props;

/* Each tile shows the cover of the section's newest post. */
const sections = categories
  .map((category) => {
    const inSection = posts.filter((post) => post.category === category.slug);
    return { ...category, count: inSection.length, cover: inSection[0]?.thumbnail };
  })
  .filter((section) => section.count > 0);
---

<section class="mt-28 sm:mt-36" aria-labelledby="sections-title">
  <div class="shell flex flex-wrap items-end justify-between gap-6">
    <div>
      <h2 id="sections-title" class="serif text-section font-normal">
        {title}
      </h2>
      {lead && <p class="mt-3 max-w-md text-body">{lead}</p>}
    </div>
    <a href="/categories/" class="group inline-flex items-center gap-1.5 text-sm font-medium">
      All sections
      <Icon
        name="arrow-right"
        class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
      />
    </a>
  </div>

  <ul class="section-tiles mt-10">
    {sections.map((section) => (
      <li>
        <a href={categoryUrl(section.slug)} class="group block">
          <div class="media relative aspect-[3/4]">
            {section.cover && (
              <Image
                src={section.cover}
                alt=""
                widths={[320, 480, 640]}
                sizes="(min-width: 64rem) 15rem, 70vw"
                quality={70}
              />
            )}
            <div class="tile-shade absolute inset-0" aria-hidden="true"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 text-white">
              <span class="serif block text-[1.625rem] leading-tight">{section.name}</span>
              <span class="mt-1 block text-sm text-white/80">{plural(section.count, "piece")}</span>
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .section-tiles {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(70%, 16rem);
    gap: 1rem;
    overflow-x: auto;
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .section-tiles::-webkit-scrollbar {
    display: none;
  }

  .section-tiles > li {
    scroll-snap-align: start;
  }

  @media (min-width: 64rem) {
    .section-tiles {
      grid-auto-flow: row;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
      overflow: visible;
      max-width: calc(var(--measure) + 2 * var(--gutter));
      margin-inline: auto;
    }
  }

  .tile-shade {
    background: linear-gradient(
      to top,
      rgb(3 20 31 / 0.72),
      rgb(3 20 31 / 0.2) 45%,
      transparent 70%
    );
  }
</style>
