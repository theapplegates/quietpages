---
import Icon from "@/components/ui/Icon.astro";
---

<button
  type="button"
  class="icon-btn"
  aria-label="Dark mode"
  aria-pressed="false"
  data-theme-toggle
  data-needs-js
>
  <Icon name="moon" class="size-[1.125rem] dark:hidden" />
  <Icon name="sun" class="hidden size-[1.125rem] dark:inline-grid" />
</button>
