---
import Hero from "@/components/home/Hero.astro";
import LatestPosts from "@/components/home/LatestPosts.astro";
import LeadStory from "@/components/home/LeadStory.astro";
import SectionTiles from "@/components/home/SectionTiles.astro";
import { homeConfig } from "@/config/home";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getLeadPost, getPosts } from "@/lib/posts";

const posts = await getPosts();
const lead = await getLeadPost();
const rest = posts.filter((post) => post.slug !== lead.slug);
---

<BaseLayout>
  <Hero lead={lead} />
  <LeadStory post={lead} />
  <LatestPosts posts={rest} />
  <SectionTiles posts={posts} title={homeConfig.sections.title} lead={homeConfig.sections.lead} />
</BaseLayout>
