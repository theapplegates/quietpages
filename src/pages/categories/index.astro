---
import SectionIndex from "@/components/home/SectionIndex.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { countBy, getPosts } from "@/lib/posts";
import { withBreadcrumbs } from "@/lib/schema";

const posts = await getPosts();
const crumbs = [{ label: "Home", href: "/" }, { label: "Sections" }];
---

<BaseLayout
  title="Sections"
  description="Essays, design, engineering, field notes, and interviews: every section of the magazine."
  structuredData={withBreadcrumbs({ "@type": "CollectionPage", name: "Sections" }, crumbs)}
>
  <PageHeader
    title="Sections"
    lead="The magazine is organised into a handful of sections, each with its own pace and voice."
    crumbs={crumbs}
  />
  <SectionIndex counts={countBy(posts, "category")} />
</BaseLayout>
