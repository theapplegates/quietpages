{
  "name": "quiet-pages",
  "version": "2.2.0",
  "description": "A quiet Astro magazine theme for essays, field notes, and long-form writing.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/prune-unused-assets.mjs",
    "preview": "astro preview",
    "cloudinary:breakpoints": "NODE_OPTIONS=--max-old-space-size=8192 node --env-file=.env scripts/cloudinary-breakpoints.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.0.4",
    "astro-cloudinary": "^1.3.5",
    "cloudinary": "^2.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "vite": "^8.1.2"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true,
    "sharp@0.35.3": true,
    "node-addon-api@8.9.0": true,
    "node-gyp@12.4.0": true,
    "fsevents@2.3.3": true
  }
}
